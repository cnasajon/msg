# Nenhum valor real aqui. Este arquivo é só o mapa das variáveis.
# Em produção, tudo é cadastrado no painel do Railway.

# Banco (no Railway: ${{postgres.DATABASE_URL}})
DATABASE_URL="postgresql://usuario:senha@localhost:5432/msg"

# URL pública da aplicação
APP_URL="http://localhost:3000"

# Gerados uma única vez com: openssl rand -base64 32
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Bot único do Telegram (@OAmsg_bot)
TELEGRAM_BOT_TOKEN=""

MAX_IMAGE_MB=2
NODE_ENV=development
TZ=UTC

# Somente no serviço worker (fase 3)
DISPATCH_INTERVAL_MINUTES=5
DISPATCH_GRACE_MINUTES=30
ALERTS_CHAT_ID=
GOOGLE_CHAT_WEBHOOK=
